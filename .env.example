# Copy to .env for local runs (never commit .env). On Render, set these in the
# service's Environment tab instead.

# Server-side only. Leave empty to run the free mock engine.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5. A smaller model is faster and cheaper but weaker on lower-resource languages.
ANTHROPIC_MODEL=

# Comma-separated access codes. Use long random codes, e.g. `python -c "import secrets; print(secrets.token_urlsafe(16))"`.
# Required whenever ANTHROPIC_API_KEY is set: the server refuses to translate without them.
ACCESS_CODES=

# Web pages allowed to call this server from another address (comma-separated).
# Defaults cover VS Code Live Server. Add your GitHub Pages address if you use it,
# e.g. https://yourname.github.io
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Limits (in memory; reset on restart)
RATE_PER_IP_PER_MIN=40
RATE_PER_CODE_PER_MIN=60
DAILY_CAP_PER_CODE=1000
DAILY_CAP_GLOBAL=10000
MAX_CHARS=1000
LOG_LEVEL=INFO
